# Copy to `.env` before running. All values shown are the defaults.

# Database. SQLite is fine until you outgrow a single box; switch to
# postgresql+psycopg://... when you do.
DB_URL=sqlite:///./data/dispatcher.db

# Where input/output zips and client installers live on disk.
STORAGE_DIR=./storage

# JWT signing secret. MUST be set in production — leaving this unset in
# prod regenerates a fresh secret on every boot and invalidates every
# session. Generate with: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=

# Session lifetime, in hours.
JWT_TTL_HOURS=168

# How long a Worker holds a task before the lease expires and the task
# returns to the pending queue. Heartbeats extend it by the same amount.
LEASE_TTL_SECONDS=300

# Retention windows before the cleaner removes files. Metadata in DB is
# kept forever; only the actual zip files get unlinked.
OUTPUT_TTL_HOURS=168          # 7 days
FAILED_INPUT_TTL_HOURS=72     # 3 days

# How often the cleaner job runs.
CLEAN_INTERVAL_SECONDS=300

# Optional bootstrap admin. If both are set AND the users table is empty
# at startup, an admin user is created automatically. Leave blank after
# first boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Allow open registration (anyone can sign up). When false, only an admin
# can create users via /api/users.
ALLOW_OPEN_REGISTRATION=false
